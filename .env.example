# Unichain Sepolia deploy: copy to .env (gitignored; forge loads it automatically), then run the
# command at the top of script/DeployLeash.s.sol.

# Deployer key, 0x-prefixed. Needs Unichain Sepolia ETH for gas.
PRIVATE_KEY=

# Optional: a PoolManager other than Uniswap's Unichain Sepolia one (required on any other chain).
# POOL_MANAGER=

# scripts/keeper.sh signer (needs gas only; settle() is open to anyone). Defaults to anvil #4 locally.
# KEEPER_PRIVATE_KEY=
